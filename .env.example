# ────────────────────────────────────────────────
#  Otaku — réglages (à remplir sur Render → Environment)
# ────────────────────────────────────────────────

# OBLIGATOIRE : le token du bot (Discord Developer Portal → Bot → Reset Token)
DISCORD_TOKEN=

# OBLIGATOIRE : l'identifiant du bot (Developer Portal → General Information → Application ID)
BOT_ID=

# OBLIGATOIRE (au moins une des deux) : clés IA gratuites
# Google Gemini : https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq : https://console.groq.com/keys
GROQ_API_KEY=

# ─── facultatif : réglages fins (les valeurs par défaut conviennent) ───
GEMINI_MODEL=gemini-3.5-flash
GROQ_MODEL=qwen/qwen3.8-27b
IA_TEMPERATURE=0.7
IA_MAX_TOKENS=900
IA_MEMOIRE=12
IA_LIMITE_MINUTE=6
IA_PAUSE_MS=15000

AUTOMOD_SPAM_MESSAGES=6
AUTOMOD_SPAM_SECONDES=8
AUTOMOD_MAJUSCULES_MIN=12
AUTOMOD_RAID_INSCRITS=6
AUTOMOD_RAID_SECONDES=20

PORT=3000

# ─── base de données gratuite (recommandé pour un bot public) ───
# MongoDB Atlas M0 → collection les réglages entre les redéploiements.
# Laisse vide pour rester en mode fichier local.
MONGODB_URI=

# Optionnel mais recommandé : phrase secrète qui verrouille /test-ia et /diagnostic
# (sans elle, ces aides au dépannage restent limitées à 3 essais/heure par visiteur).
# Invente-en une, ex. : chat-bleu-42-render
JETON_SANTE=
